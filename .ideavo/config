{
  "systemSetup": [
    {
      "name": "Install pnpm",
      "command": "npm i -g pnpm@10"
    }
  ],
  "templateName": "custom",
  "projectDependencies": [
    {
      "name": "Install Dependencies",
      "command": "CI=true pnpm install --frozen-lockfile"
    }
  ],
  "codeChecks": [
    {
      "name": "TypeCheck",
      "command": "pnpm run typecheck"
    }
  ],
  "buildSteps": [
    {
      "name": "Build Project",
      "command": "pnpm run build"
    }
  ],
  "runStep": [
    {
      "name": "Run Dev Server",
      "command": "PORT=8080 pnpm --filter @workspace/api-server run dev & PORT=4000 BASE_PATH=/ pnpm --filter @workspace/tnc-web run dev",
      "port": "4000"
    }
  ],
  "deploySteps": [
    {
      "name": "Build for Deploy",
      "command": "bash build.sh"
    }
  ],
  "cleanupFiles": [
    "node_modules",
    "artifacts/api-server/dist",
    "artifacts/tnc-web/dist",
    "artifacts/mockup-sandbox/dist",
    "artifacts/api-server/.tsbuildinfo",
    "artifacts/tnc-web/.tsbuildinfo",
    "lib/api-client-react/tsconfig.tsbuildinfo",
    "lib/api-zod/tsconfig.tsbuildinfo",
    "lib/db/tsconfig.tsbuildinfo",
    "lib/api-client-react/dist",
    "lib/api-zod/dist",
    "lib/db/dist"
  ],
  "packageManager": "pnpm",
  "envPaths": [
    {
      "name": "default",
      "path": ".env"
    },
    {
      "name": "api-server",
      "path": "artifacts/api-server/.env"
    },
    {
      "name": "tnc-web",
      "path": "artifacts/tnc-web/.env"
    },
    {
      "name": "db",
      "path": "lib/db/.env"
    }
  ]
}
